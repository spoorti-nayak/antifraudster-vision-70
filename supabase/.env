# Edge Functions Environment Variables
# Replace these values with your actual Supabase project credentials

# Get from: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your_project_id.supabase.co

# Get from: Supabase Dashboard → Project Settings → API → Project API keys → anon public
SUPABASE_ANON_KEY=your_anon_key_here

# Get from: Supabase Dashboard → Project Settings → API → Project API keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Get from: Supabase Dashboard → Project Settings → Database → Connection String → URI
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:your_password@your_host:5432/postgres

# Optional: Only needed if using Lovable AI features
LOVABLE_API_KEY=la_your_api_key_here
